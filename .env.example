# ResQLink AI Disaster Management Platform Environment Template
# Copy this file to .env and populate with deployment credentials

# Core Backend REST API
API_BASE_URL=https://api.resqlink.tn.gov.in/v1

# Real-time WebSocket Gateway
WS_TELEMETRY_URL=wss://api.resqlink.tn.gov.in/v1/telemetry

# AI Commander / Gemini Model Gateway
AI_COMMANDER_API_ENDPOINT=https://ai.resqlink.tn.gov.in/v1/infer
AI_COMMANDER_API_KEY=your_gemini_api_key_here

# Hardware BLE Mesh Configuration
BLE_SERVICE_UUID=0000ffe0-0000-1000-8000-00805f9b34fb
BLE_TX_POWER_DBM=4

# Map Tile Server & Vector Cache
MAP_TILE_SERVER_URL=https://tiles.resqlink.tn.gov.in/vector/{z}/{x}/{y}.pbf
MAP_OFFLINE_CACHE_LIMIT_MB=512

# Environment State
ENVIRONMENT=production
ENABLE_MOCK_TELEMETRY=false
LOG_LEVEL=INFO
